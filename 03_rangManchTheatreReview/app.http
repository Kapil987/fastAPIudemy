
@baseUrl = http://127.0.0.1:8000
@reviewUrl = {{baseUrl}}/review

### 1. Create Review - Valid Request
POST {{reviewUrl}}/
Content-Type: application/json

{
    "play_name": "Hamlet",
    "reviewer_name": "John",
    "rating": 5,
    "comment": "Excellent performance!"
}

###

### 2. Create Another Review
POST {{reviewUrl}}/
Content-Type: application/json

{
    "play_name": "Hamlet",
    "reviewer_name": "Alice",
    "rating": 4,
    "comment": "Very good acting."
}

###

### 3. Create Review - Different Play
POST {{reviewUrl}}/
Content-Type: application/json

{
    "play_name": "Macbeth",
    "reviewer_name": "David",
    "rating": 3,
    "comment": "Good story but slow pacing."
}

###

### 4. Create Review - Minimum Rating
POST {{reviewUrl}}/
Content-Type: application/json

{
    "play_name": "Othello",
    "reviewer_name": "Sarah",
    "rating": 1,
    "comment": "Disappointing experience."
}

###

### 5. Create Review - Maximum Rating
POST {{reviewUrl}}/
Content-Type: application/json

{
    "play_name": "Macbeth",
    "reviewer_name": "Mike",
    "rating": 5,
    "comment": "Outstanding performance!"
}

###

### 6. Create Review - Invalid Rating (Validation Test)
POST {{reviewUrl}}/
Content-Type: application/json

{
    "play_name": "Hamlet",
    "reviewer_name": "Test User",
    "rating": 6,
    "comment": "Testing invalid rating."
}

###

### 7. Get All Reviews
GET {{reviewUrl}}

###

### 8. Get Review by ID
GET {{reviewUrl}}/1

###

### 9. Get Non-existent Review (404 Test)
GET {{reviewUrl}}/9999

###

### 10. Filter Reviews by Play Name
GET {{reviewUrl}}/?play_name=Hamlet

###

### 11. Pagination - Skip First Review
GET {{reviewUrl}}/?skip=1&limit=2

###

### 12. Pagination - Custom Limit
GET {{reviewUrl}}/?skip=0&limit=3

###

### 13. Pagination - Invalid Limit (Validation Test)
GET {{reviewUrl}}/?skip=0&limit=100

###

### 14. Average Rating for Hamlet
GET {{reviewUrl}}/average/Hamlet

###

### 15. Average Rating for Macbeth
GET {{reviewUrl}}/average/Macbeth

###

### 16. Average Rating - No Reviews (404 Test)
GET {{reviewUrl}}/average/King%20Lear

###

### 17. PATCH - Update Only Rating
PATCH {{reviewUrl}}/3
Content-Type: application/json

{
    "rating": 3
}

###

### 18. PATCH - Update Only Comment
PATCH {{reviewUrl}}/2
Content-Type: application/json

{
    "comment": "Updated after watching it again."
}

###

### 19. PATCH - Update Multiple Fields
PATCH {{reviewUrl}}/3
Content-Type: application/json

{
    "rating": 5,
    "comment": "Changed my mind. Excellent play!"
}

###

### 20. PATCH - Invalid Rating (Validation Test)
PATCH {{reviewUrl}}/1
Content-Type: application/json

{
    "rating": 10
}

###

### 21. PATCH - Non-existent Review (404 Test)
PATCH {{reviewUrl}}/9999
Content-Type: application/json

{
    "rating": 4
}

###

### 22. DELETE - Delete Review
DELETE {{reviewUrl}}/4

###

### 23. DELETE - Delete Non-existent Review (404 Test)
DELETE {{reviewUrl}}/9999

###

### 24. Verify Deleted Review
GET {{reviewUrl}}/4
